# ============================================================
# .env.production.example
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env real a GitHub.
# ============================================================

# ── MongoDB Atlas (externo) ──────────────────────────────────────────────────
# Usar URI directa mongodb:// en lugar de mongodb+srv:// para evitar timeouts DNS
MONGODB_URI=mongodb://USUARIO:PASSWORD@host1.mongodb.net:27017,host2.mongodb.net:27017,host3.mongodb.net:27017/?tls=true&authSource=admin&replicaSet=atlas-XXXX-shard-0&retryWrites=true&w=majority&appName=CLUSTER
MONGODB_DATABASE=politicas_negocio_db

# ── AWS S3 (externo) ─────────────────────────────────────────────────────────
# Opción 1: Credenciales explícitas en .env
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Opción 2 (recomendada): IAM Instance Role en EC2 → dejar vacías las credenciales
# y el SDK de AWS las tomará automáticamente del metadata de la instancia.
AWS_REGION=sa-east-1
S3_BUCKET=

# Tipo de storage: "s3" para producción con S3, "local" para desarrollo
APP_STORAGE_TYPE=s3
APP_STORAGE_S3_KEY_PREFIX=adjuntos/

# ── DeepSeek API ─────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_USER_GUIDE_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=0
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_ENABLED=true

# ── Correo Gmail SMTP ────────────────────────────────────────────────────────
# Usar una "App Password" de Gmail (no la contraseña de la cuenta).
# Configurar en: https://myaccount.google.com/apppasswords
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# ── OnlyOffice Document Server ───────────────────────────────────────────────
# JWT está deshabilitado por defecto (presentación). Habilitar en producción real.
ONLYOFFICE_JWT_ENABLED=false
ONLYOFFICE_JWT_SECRET=
# URL pública del EC2 para que OnlyOffice pueda hacer callbacks al backend
# Cuando frontend, backend y onlyoffice están en el mismo EC2 vía Docker:
# usar la IP pública del EC2 o el dominio, ya que OnlyOffice necesita acceder
# a los documentos públicamente.
ONLYOFFICE_CALLBACK_BASE_URL=http://TU-IP-EC2:8080

# ── URLs Públicas ─────────────────────────────────────────────────────────────
# Reemplazar con la IP pública del EC2 o dominio una vez desplegado.
APP_PUBLIC_BASE_URL=http://TU-IP-EC2
APP_FRONTEND_URL=http://TU-IP-EC2
FRONTEND_URL=http://TU-IP-EC2
BACKEND_URL=http://TU-IP-EC2/api

# ── CORS — Orígenes permitidos ────────────────────────────────────────────────
# IP pública del EC2 más cualquier dominio adicional
APP_CORS_ALLOWED_ORIGINS=http://TU-IP-EC2,http://localhost:4200

# ── Firebase Web SDK (frontend) ──────────────────────────────────────────────
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MEASUREMENT_ID=
FIREBASE_WEB_VAPID_KEY=

# ── Firebase Server SDK (backend) ─────────────────────────────────────────────
# Exportar el JSON de service account de Firebase como base64:
#   base64 -w 0 firebase-service-account.json
APP_NOTIFICATIONS_FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
APP_PAYMENTS_STRIPE_SUCCESS_URL=http://TU-IP-EC2/pagos/stripe/success?session_id={CHECKOUT_SESSION_ID}
APP_PAYMENTS_STRIPE_CANCEL_URL=http://TU-IP-EC2/pagos/cancelado

# ── PayPal ────────────────────────────────────────────────────────────────────
APP_PAYMENTS_PAYPAL_BASE_URL=https://www.paypal.com/cgi-bin/webscr
APP_PAYMENTS_PAYPAL_BUSINESS_EMAIL=
APP_PAYMENTS_PAYPAL_RETURN_URL=http://TU-IP-EC2/pagos/paypal/retorno
APP_PAYMENTS_PAYPAL_CANCEL_URL=http://TU-IP-EC2/pagos/cancelado
APP_PAYMENTS_DEMO_MANUAL_PAYPAL_APPROVAL_ENABLED=true

# ── Spring Boot ───────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=default
APP_SEED_POLITICAS_WIFI_ENABLED=false

# ── API Frontend → Backend ─────────────────────────────────────────────────────
# Vacío = usar rutas relativas (/api/...) via proxy Nginx en el mismo servidor.
# Cambiar solo si frontend y backend están en dominios distintos.
API_BASE_URL=

# ── Variables internas (NO modificar) ─────────────────────────────────────────
# Estas URLs usan nombres de servicio Docker y son gestionadas internamente.
# No se necesitan en .env, están hardcodeadas en docker-compose.yml:
#   IA_SERVICE_URL=http://ia-service:8000
#   IA_DEEP_LEARNING_URL=http://ia-deep-learning-service:8010
#   ONLYOFFICE_DOCUMENT_SERVER_URL=http://onlyoffice:80
#   BACKEND_BASE_URL=http://backend:8080
