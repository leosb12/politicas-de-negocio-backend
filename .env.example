# Copia este archivo como .env y completa los valores de Mongo Atlas.
# No subas el archivo .env real al repositorio.
# Estas variables se usan tanto en ejecucion local como en Docker.
# En redes con timeout de DNS TXT, preferir URI directa mongodb:// en lugar de mongodb+srv://

MONGODB_URI=mongodb://usuario:password@host1.mongodb.net:27017,host2.mongodb.net:27017,host3.mongodb.net:27017/?tls=true&authSource=admin&replicaSet=atlas-xxxxx-shard-0&retryWrites=true&w=majority&appName=cluster
MONGODB_DATABASE=politicas_negocio_db
SPRING_PROFILES_ACTIVE=default

# CORS para frontend web/movil en produccion (separado por comas)
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Almacenamiento de adjuntos
# local: usa /app/uploads (requiere volumen persistente)
# s3: recomendado para produccion
APP_STORAGE_TYPE=local
APP_STORAGE_S3_BUCKET=mi-bucket
APP_STORAGE_S3_REGION=us-east-1
APP_STORAGE_S3_KEY_PREFIX=adjuntos/

# Notificaciones push con Firebase Cloud Messaging
# En produccion/AWS, guarda el JSON de service account en Secrets Manager/SSM
# y exponlo como base64 en FIREBASE_SERVICE_ACCOUNT_BASE64.
APP_NOTIFICATIONS_FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=mi-proyecto-firebase
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_SERVICE_ACCOUNT_PATH=
